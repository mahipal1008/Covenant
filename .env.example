# --- Core --------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_SITE_URL=https://covenant.dev
DATABASE_URL=postgresql://covenant:dev_only_change_me@localhost:5433/covenant?schema=public
DATABASE_REPLICA_URL=
REDIS_URL=redis://localhost:6380

# --- Auth + identity ---------------------------------------------------
GITHUB_CLIENT_ID=stub
GITHUB_CLIENT_SECRET=stub
# WorkOS dev tenant (Session 7 §1). Activates the workos SSO broker.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_REDIRECT_URI=http://localhost:4000/v1/sso/workos/callback

# --- Billing -----------------------------------------------------------
# STRIPE_MODE controls which key set is loaded. `test` (default) accepts
# only `sk_test_*` / `whsec_*` from the Stripe CLI. `live` requires real
# keys plus a tax registration ENV gate (see docs/runbooks/stripe-go-live.md).
STRIPE_MODE=test
STRIPE_SECRET_KEY=stub
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_TAX_REGISTRATION_VERIFIED=false

# --- Notifications -----------------------------------------------------
SLACK_SIGNING_SECRET=stub
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Slack distribute URL is generated from the manifest at deploy/slack/manifest.json.

# --- Observability -----------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_DSN=
# PagerDuty Events API v2 routing key for the on-call rotation.
PAGERDUTY_ROUTING_KEY=
# Statuspage — either ours (managed) or self-hosted promoted to public.
STATUSPAGE_PAGE_ID=
STATUSPAGE_API_KEY=
STATUSPAGE_PUBLIC_URL=https://status.covenant.dev

# --- Storage -----------------------------------------------------------
EVIDENCE_S3_ENDPOINT=
EVIDENCE_S3_BUCKET=
EVIDENCE_S3_REGION=us-east-1
EVIDENCE_S3_FORCE_PATH_STYLE=true

# --- AI ----------------------------------------------------------------
AI_PROVIDER=stub
