{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@covenant/shared": ["../../packages/shared/src/index.ts"],
      "@covenant/analyzer": ["../../packages/analyzer/src/index.ts"],
      "@covenant/db": ["../../packages/db/src/index.ts"]
    },
    "plugins": [{ "name": "next" }],
    "types": ["node"]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "**/*.stories.tsx", "**/*.stories.ts"]
}
