{
  "name": "Covenant",
  "url": "https://covenant.dev",
  "hook_attributes": {
    "url": "https://api.covenant.dev/v1/github/webhook"
  },
  "redirect_url": "https://app.covenant.dev/integrations/github/callback",
  "callback_urls": ["https://app.covenant.dev/auth/github/callback"],
  "setup_url": "https://app.covenant.dev/integrations/github/setup",
  "setup_on_update": true,
  "public": true,
  "request_oauth_on_install": false,
  "default_permissions": {
    "actions": "read",
    "checks": "write",
    "contents": "read",
    "deployments": "read",
    "issues": "write",
    "metadata": "read",
    "pull_requests": "write",
    "secret_scanning_alerts": "read",
    "security_events": "read",
    "statuses": "write",
    "vulnerability_alerts": "read",
    "workflows": "write",
    "members": "read",
    "organization_administration": "read"
  },
  "default_events": [
    "check_run",
    "check_suite",
    "code_scanning_alert",
    "deployment",
    "deployment_status",
    "issues",
    "issue_comment",
    "member",
    "membership",
    "organization",
    "pull_request",
    "pull_request_review",
    "pull_request_review_comment",
    "push",
    "release",
    "repository",
    "secret_scanning_alert",
    "security_advisory",
    "team",
    "team_add",
    "workflow_run"
  ],
  "description": "Living intelligence for SaaS codebases — 20 always-on agents that document, secure, audit, and enforce your code on every commit.",
  "_comment": "Submit this manifest at https://github.com/settings/apps/new?manifest=<JSON>. After creation GitHub returns the App's id, slug, and private key — populate GITHUB_APP_ID / GITHUB_APP_PRIVATE_KEY env vars (Session 7 §10)."
}
